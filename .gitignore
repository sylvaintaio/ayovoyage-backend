# Secrets locaux : ne jamais versionner (modèle : .env.example)
.env
.env.*
!.env.example

# Binaires et sorties de build
/bin/
/api-server
/busvoyage-api
*.exe
*.test
*.out
coverage.*

# Exports et sauvegardes de base
*.dump
*.sql.gz
/exports/

# Éditeurs et système
.idea/
.vscode/
.DS_Store

# Kit de déploiement : valeurs locales (SMTP, SMS) préparées par make-overrides.py
/deploy/out/

# Clé de compte de service Firebase (secret) : jamais dans le dépôt
*firebase-adminsdk*.json
*service-account*.json
