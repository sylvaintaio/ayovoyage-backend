# ---------------------------------------------------------------- Application
APP_ENV=development                 # development | staging | production
HTTP_ADDR=:8080
PUBLIC_API_URL=http://localhost:8080
PUBLIC_WEB_URL=http://localhost:4200
CORS_ORIGINS=http://localhost:4200
TRUST_PROXY=false                   # true uniquement derrière Caddy
ENABLE_DOCS=true
DEFAULT_COUNTRY_CODE=229

# ---------------------------------------------------------------- Base de données
# Rôle applicatif (soumis au Row-Level Security)
DATABASE_URL=postgres://busvoyage_app:app_dev_password@localhost:55432/busvoyage?sslmode=disable
# Rôle propriétaire (migrations uniquement)
MIGRATION_DATABASE_URL=postgres://busvoyage_owner:owner_dev_password@localhost:55432/busvoyage?sslmode=disable
AUTO_MIGRATE=false

# ---------------------------------------------------------------- Secrets (générer avec : openssl rand -base64 48)
JWT_SECRET=change-me-dev-only-0123456789abcdefghijklmnop
OTP_SECRET=change-me-dev-only-otp-0123456789abcdefghijk
# Seed Ed25519 de 32 octets en base64 (openssl rand -base64 32). Obligatoire hors développement.
TICKET_SIGNING_KEY=
TICKET_SIGNING_KEY_ID=k1
# Après une rotation (api ticket-key) : anciennes clés publiques encore acceptées, kid:base64
TICKET_VERIFY_KEYS=
# Chiffrement des secrets de double authentification (openssl rand -base64 32), obligatoire en production
MFA_ENCRYPTION_KEY=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
COOKIE_DOMAIN=
# Préfixe de publication de l'API (Caddy en production, proxy Angular en développement)
COOKIE_PATH_PREFIX=/api

# ---------------------------------------------------------------- Paiement
PAYMENT_PROVIDERS=mock              # ex. fedapay (mock interdit hors développement)
FEDAPAY_ENV=sandbox
FEDAPAY_SECRET_KEY=
FEDAPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------- Connexion des clients
# Canaux d'envoi du code : email, sms (séparés par des virgules, le premier est proposé par défaut)
OTP_CHANNELS=email
# Nom de la plateforme : e-mails (expéditeur, sujets, pied), factures, double authentification,
# documentation de l'API. Côté site web : web/src/app/content/brand.ts (garder le même nom).
BRAND_NAME=BUS-VOYAGE
# Contacts affichés en pied des e-mails (laisser vide pour masquer)
SUPPORT_PHONE=+229 01 00 00 00 00
SUPPORT_EMAIL=contact@busvoyage.bj
SUPPORT_WHATSAPP=22901000000

# ---------------------------------------------------------------- SMS
# Sans fournisseur : SMS_DRIVER=log (rien n'est envoyé, messages notés « simulés »).
# Avec un fournisseur : SMS_DRIVER=http et les SMS_HTTP_* décrivant son API (voir docs/sms.md).
SMS_DRIVER=log
SMS_SENDER_ID=                      # nom d'expéditeur (11 caractères max., à faire valider par le fournisseur)
SMS_ASCII=true                      # retire les accents : 160 caractères par SMS au lieu de 70
SMS_MAX_SEGMENTS=3                  # SMS concaténés au plus par message
# SMS_HTTP_URL=https://api.fournisseur.example/v1/sms
# SMS_HTTP_METHOD=POST              # POST | GET
# SMS_HTTP_FORMAT=json              # json | form | none (tout dans l'URL)
# Entre apostrophes dès que la valeur contient " & { ou des espaces (sinon le shell la modifie) :
# SMS_HTTP_BODY='{"from":"{{sender}}","to":"{{to}}","text":"{{message}}"}'
# SMS_HTTP_AUTH=bearer              # none | bearer | basic | header
# SMS_HTTP_TOKEN=
# SMS_HTTP_USER=
# SMS_HTTP_PASSWORD=
# SMS_HTTP_HEADER_NAME=X-API-Key    # avec SMS_HTTP_AUTH=header
# SMS_HTTP_PHONE_FORMAT=e164        # e164 (+229…) | digits (229…) | national (01…)
# SMS_HTTP_SUCCESS=                 # texte attendu dans la réponse (facultatif)
# SMS_HTTP_TIMEOUT=15s

# ---------------------------------------------------------------- E-mail
EMAIL_DRIVER=log                    # log | smtp
# SMTP (ex. LWS : mailXX.lwspanel.com, port 465 en SSL ou 587 en STARTTLS).
# Les noms Laravel sont aussi acceptés : MAIL_HOST, MAIL_PORT, MAIL_USERNAME, MAIL_PASSWORD, MAIL_FROM_ADDRESS.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# EMAIL_FROM : facultatif, par défaut « BRAND_NAME <MAIL_FROM_ADDRESS> ».
# EMAIL_FROM="Mon expéditeur <no-reply@example.com>"
