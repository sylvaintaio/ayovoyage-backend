# Configuration de production de l'API : /etc/busvoyage/api.env (root:busvoyage, droits 640).
# Créé par setup-server.sh, qui remplace les valeurs __…__ (domaine, port, mots de passe, secrets).
# Ne jamais versionner le fichier rempli.
#
# Règles d'écriture (fichier lu par systemd ET par le shell) :
#   - pas de commentaire en fin de ligne : un commentaire occupe toute sa ligne ;
#   - valeur entre apostrophes dès qu'elle contient une espace, " & { } ; $ ou # ;
#   - après modification : sudo systemctl restart busvoyage-api

# --- Environnement
# staging : recette en ligne (sécurité de production, paiement simulé et démonstration permis).
# production : exploitation réelle (FedaPay obligatoire).
APP_ENV=staging
HTTP_ADDR=127.0.0.1:__PORT__
PUBLIC_API_URL=https://__DOMAIN__
PUBLIC_WEB_URL=https://ayovoyage.vercel.app
CORS_ORIGINS=https://ayovoyage.vercel.app
ENABLE_DOCS=false
DEFAULT_COUNTRY_CODE=229

# Derrière Nginx (et Vercel pour le site) : lire l'IP réelle du client.
TRUST_PROXY=true
# Le site passe par Vercel, qui relaie /api vers l'API : les cookies vivent sous /api.
COOKIE_PATH_PREFIX=/api
COOKIE_SECURE=true

# --- Base de données (PostgreSQL local, rôles créés par 01-database.sql)
DATABASE_URL=postgres://busvoyage_app:__DB_APP_PASSWORD__@127.0.0.1:5432/busvoyage?sslmode=disable
MIGRATION_DATABASE_URL=postgres://busvoyage_owner:__DB_OWNER_PASSWORD__@127.0.0.1:5432/busvoyage?sslmode=disable
AUTO_MIGRATE=true

# --- Secrets (générés par setup-server.sh ; à sauvegarder hors du serveur)
JWT_SECRET=__JWT_SECRET__
OTP_SECRET=__OTP_SECRET__
# Clé des billets : la perdre invalide tous les billets émis.
TICKET_SIGNING_KEY=__TICKET_SIGNING_KEY__
TICKET_SIGNING_KEY_ID=k1
TICKET_VERIFY_KEYS=
# Chiffre les secrets de double authentification : ne plus jamais la changer une fois en service.
MFA_ENCRYPTION_KEY=__MFA_ENCRYPTION_KEY__

# --- Identité et contacts (pied des e-mails)
# Garder le même nom que web/src/app/content/brand.ts.
BRAND_NAME='Ayò Voyage'
SUPPORT_PHONE=
SUPPORT_EMAIL=
SUPPORT_WHATSAPP=

# --- Connexion client et e-mails
# email, ou email,sms une fois le fournisseur SMS validé.
OTP_CHANNELS=email
EMAIL_DRIVER=smtp
MAIL_HOST=mail96.lwspanel.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=

# --- Paiement
# staging : mock permis. production : fedapay (FEDAPAY_ENV=live une fois validé).
PAYMENT_PROVIDERS=mock
FEDAPAY_ENV=sandbox
FEDAPAY_SECRET_KEY=
FEDAPAY_WEBHOOK_SECRET=

# --- SMS (voir docs/sms.md)
# log : rien n'est envoyé (messages notés « simulés »). http : fournisseur décrit par SMS_HTTP_*.
SMS_DRIVER=log
# Nom d'expéditeur : 11 caractères au plus, approuvé par le fournisseur (vide = expéditeur par défaut).
SMS_SENDER_ID=
# Retire les accents : 160 caractères par SMS au lieu de 70.
SMS_ASCII=true
SMS_MAX_SEGMENTS=3
# Exemple Africa's Talking :
# SMS_HTTP_URL=https://api.africastalking.com/version1/messaging
# SMS_HTTP_FORMAT=form
# SMS_HTTP_BODY='username={{user}}&to={{to}}&message={{message}}&from={{sender}}'
# SMS_HTTP_AUTH=header
# SMS_HTTP_HEADER_NAME=apiKey
# SMS_HTTP_TOKEN=
# SMS_HTTP_USER=
# SMS_HTTP_SUCCESS=Success
